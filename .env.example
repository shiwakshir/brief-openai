# Required outside development/test
OPENAI_API_KEY=your_project_service_account_key_here
BRIEF_ENVIRONMENT=development

# Development only. Never enable in a shared or production environment.
BRIEF_ALLOW_INSECURE_DEVELOPMENT=true

# Pilot fallback only. Prefer an OIDC identity-aware proxy.
BRIEF_PASSWORD=
BRIEF_TRUST_AUTH_PROXY=false
BRIEF_AUTH_USER_HEADER=X-Forwarded-User

OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_GROUNDING_MODEL=gpt-5.4-mini
OPENAI_GROUNDING_EFFORT=low
OPENAI_PROBE_MODELS=gpt-4.1-mini,gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2

# Web search is an explicit data-governance decision.
BRIEF_ENABLE_WEB_GROUNDING=false

# Raw prompts and model responses are not persisted unless explicitly approved.
BRIEF_LOG_RAW_PAYLOADS=false
BRIEF_RUN_LOG_DIR=runs
BRIEF_SESSION_TTL_SECONDS=1800
BRIEF_RUN_TIMEOUT_SECONDS=900

BRIEF_MAX_CONTENT_LENGTH=2097152
BRIEF_MAX_UPLOAD_BYTES=2097152
BRIEF_MAX_DOCX_EXPANDED_BYTES=10485760
BRIEF_MAX_PDF_PAGES=100
BRIEF_MAX_CONCURRENT_JOBS=2
BRIEF_MAX_SESSIONS=100
BRIEF_PROBE_WORKERS=8
