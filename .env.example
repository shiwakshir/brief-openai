# Required
OPENAI_API_KEY=your_api_key_here

# Optional. Route API calls through an internal gateway or proxy.
# OPENAI_BASE_URL=https://ai-gateway.example.com/v1

# Optional. Defaults shown.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_GROUNDING_MODEL=gpt-5.4-mini
OPENAI_GROUNDING_EFFORT=low
# Models whose answers are probed for consensus (comma-separated)
OPENAI_PROBE_MODELS=gpt-4.1-mini,gpt-5.4-mini

# Optional. Set this to put a shared password on the hosted app.
BRIEF_PASSWORD=
